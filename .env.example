# .env.example
# All environment variables in Plotforge have built-in fallbacks.
# No secret configuration is required.

# Maximum character limit for AI Copilot / Chatbot responses
# Options: 500 (concise), 1200 (standard), 2500 (detailed scene draft), or any integer
CHATBOT_MAX_CHARS=1200
VITE_CHATBOT_MAX_CHARS=1200

# Optional personal Gemini API Key (if bypassing shared rate limits)
# GEMINI_API_KEY=

# Optional Platform Owner credentials (configured in deployment secrets, never in repository source)
# OWNER_EMAIL=
# OWNER_PASSWORD=
# OWNER_USERNAME=
# JWT_SECRET=

# Optional Firebase Web API Key for client and server (never commit real secrets here)
# VITE_FIREBASE_API_KEY=
# FIREBASE_API_KEY=

# Optional TMDB API Key for movie poster search
# TMDB_API_KEY=
